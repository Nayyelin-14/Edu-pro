generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  username            String               @unique
  password            String
  role                UserRole             @default(STUDENT)
  avatar              String?
  twoStep             TWO_STEP             @default(DISABLED)
  twoStepSecret       String?
  emailVerifiedAt     DateTime?
  isBanned            Boolean              @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  certificates        Certificate[]
  certificateRequests CertificateRequest[]
  comments            Comment[]
  commentLikes        CommentLike[]
  completedLessons    CompletedLesson[]
  instructorCourses   Course[]
  enrollments         Enrollment[]
  actedNotifications  Notification[]       @relation("Notification_actorIdToUser")
  notifications       Notification[]       @relation("Notification_userIdToUser")
  orders              Order[]
  otpCodes            OtpCode[]
  passwordResets      PasswordReset[]
  quizResults         QuizResult[]
  refreshTokens       RefreshToken[]
  reportsFiled        Report[]             @relation("Reporter")
  reviews             Review[]
  roadmaps            Roadmap[]
  roadmapGenerations  RoadmapGeneration[]
  testResults         TestResult[]
  wishlistItems       WishlistItem[]

  tenantMemberships TenantMembership[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  codeHash  String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  courses     Course[]
}

model Course {
  id                  String               @id @default(cuid())
  tenantId            String
  slug                String               @unique
  title               String
  subtitle            String?
  description         String?
  coverImage          String?
  price               Int                  @default(0)
  isPublished         Boolean              @default(false)
  isFeatured          Boolean              @default(false)
  categoryId          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  rating              Float                @default(0)
  ratingCount         Int                  @default(0)
  studentCount        Int                  @default(0)
  approvalStatus      ApprovalStatus       @default(DRAFT)
  instructorId        String?
  difficulty          CourseDifficulty     @default(BEGINNER)
  estimatedHours      Int?
  prerequisites       Json                 @default("[]")
  skills              Json                 @default("[]")
  certificates        Certificate[]
  certificateRequests CertificateRequest[]
  category            Category?            @relation(fields: [categoryId], references: [id])
  instructor          User?                @relation(fields: [instructorId], references: [id])
  enrollments         Enrollment[]
  modules             Module[]
  notifications       Notification[]
  orders              Order[]
  reports             Report[]
  reviews             Review[]
  roadmaps            Roadmap[]
  roadmapItems        RoadmapItem[]
  tests               Test[]
  wishlistItems       WishlistItem[]

  @@index([isPublished, createdAt])
  @@index([categoryId])
  @@index([instructorId])
  @@index([prerequisites], map: "Course_prerequisites_gin", type: Gin)
  @@index([skills], map: "Course_skills_gin", type: Gin)
  @@index([tenantId])
}

model Module {
  id          String   @id @default(cuid())
  tenantId    String
  courseId    String
  title       String
  description String?
  position    Int
  createdAt   DateTime @default(now())
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes     Quiz[]

  @@unique([courseId, position])
  @@index([courseId])
  @@index([tenantId])
}

model Lesson {
  id            String            @id @default(cuid())
  tenantId      String
  moduleId      String
  title         String
  // Persisted lesson type — authoritative for rendering/validation. NEVER
  // infer from which nullable field happens to be populated.
  type          LessonType
  videoUrl      String?           // direct URL for legacy/external videos; asset-backed videos resolve via Asset + signed URL
  pdfUrl        String?           // legacy/direct reference only; asset-backed PDFs resolve via Asset + signed URL
  videoDuration Int?
  article       String?           // sanitized rich-text HTML (READING/rich-text source)
  position      Int
  isFree        Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  comments      Comment[]
  completedBy   CompletedLesson[]
  assets        Asset[]
  module        Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position])
  @@index([moduleId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Media assets (spec: storage abstraction).
//
// PostgreSQL stores ONLY references/metadata — never binary data. Actual
// video/PDF/image bytes live in Cloudinary. The Asset row is the
// application-level source of truth for every uploaded file, keeping the
// provider asset identifier that was previously discarded after upload.
// ---------------------------------------------------------------------------

enum AssetKind {
  VIDEO
  PDF
}

enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model Asset {
  id           String      @id @default(cuid())
  tenantId     String
  lessonId     String?
  courseId     String      // denormalized for tenant-aware storage paths
  kind         AssetKind
  status       AssetStatus @default(UPLOADING)
  publicId     String      @unique // Cloudinary public_id (controlled, generated server-side)
  resourceType String      // cloudinary resource type: "video" | "image" | "raw"
  format       String?     // detected format AFTER upload verification (mp4/webm/pdf/...)
  filename     String?     // sanitized original filename (display only)
  bytes        BigInt?     // verified size at completion
  duration     Float?      // seconds, as reported by the provider (videos)
  metadata     Json?       // provider-specific extras (safe fields only)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lesson       Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([lessonId, kind])
  @@index([tenantId])
  @@index([status])
}

/// Archive of pre-migration lesson content that violated the new one-source
/// content rules. No FK: archive rows must survive lesson deletion. Rows here
/// were NOT destroyed by the migration — they live on in this table.
model LessonContentArchive {
  id         String   @id @default(cuid())
  tenantId   String
  lessonId   String
  lessonTitle String
  reason     String   // VIDEO_AND_ARTICLE | INCOMPLETE
  videoUrl   String?
  article    String?
  archivedAt DateTime @default(now())

  @@index([lessonId])
}

model Enrollment {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  courseId    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, tenantId])
  @@index([courseId])
  @@index([tenantId])
}

model CompletedLesson {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([tenantId])
}

model Quiz {
  id          String       @id @default(cuid())
  tenantId    String
  moduleId    String
  title       String
  questions   Json         @default("[]")
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizResults QuizResult[]

  @@index([moduleId, position])
  @@index([tenantId])
}

model QuizResult {
  id        String   @id @default(cuid())
  tenantId  String
  quizId    String
  userId    String
  score     Int
  total     Int
  passed    Boolean
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model Test {
  id               String       @id @default(cuid())
  tenantId         String
  courseId         String
  title            String
  description      String?
  questions        Json         @default("[]")
  passingScore     Int          @default(60)
  timeLimitMinutes Int          @default(30)
  attemptLimit     Int          @default(3)
  isEnabled        Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  course           Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  testResults      TestResult[]

  @@index([courseId])
  @@index([tenantId])
}

model TestResult {
  id                  String               @id @default(cuid())
  tenantId            String
  testId              String
  userId              String
  score               Int
  total               Int
  percent             Int
  passed              Boolean
  answers             Json                 @default("[]")
  startedAt           DateTime
  submittedAt         DateTime             @default(now())
  timeTakenSeconds    Int                  @default(0)
  certificates        Certificate[]
  certificateRequests CertificateRequest[]
  test                Test                 @relation(fields: [testId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([testId, userId])
  @@index([userId])
  @@index([tenantId])
}

model Certificate {
  id                String      @id @default(cuid())
  tenantId          String
  certificateNumber String      @unique
  courseId          String
  userId            String
  testResultId      String?
  pdfUrl            String?
  issuedAt          DateTime    @default(now())
  course            Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  testResult        TestResult? @relation(fields: [testResultId], references: [id])
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, tenantId])
  @@index([courseId])
  @@index([tenantId])
}

model Comment {
  id        String        @id @default(cuid())
  lessonId  String
  userId    String
  content   String
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  likeCount Int           @default(0)
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommentLike[]

  @@index([lessonId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  tenantId  String
  courseId  String
  userId    String
  rating    Int
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, tenantId])
  @@index([courseId])
  @@index([tenantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, tenantId])
  @@index([courseId])
  @@index([tenantId])
}

model Report {
  id         String       @id @default(cuid())
  tenantId   String
  courseId   String
  reporterId String
  reason     String
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([courseId])
  @@index([tenantId])
}

model CertificateRequest {
  id           String                   @id @default(cuid())
  userId       String
  courseId     String
  testResultId String?
  status       CertificateRequestStatus @default(PENDING)
  note         String?
  decidedAt    DateTime?
  decidedById  String?
  createdAt    DateTime                 @default(now())
  course       Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  testResult   TestResult?              @relation(fields: [testResultId], references: [id])
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
  @@index([userId])
}

model Roadmap {
  id                 String          @id @default(cuid())
  tenantId           String
  userId             String
  title              String
  goal               String
  level              RoadmapLevel
  durationWeeks      Int
  hoursPerWeek       Int
  language           String          @default("en")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  provider           String?
  model              String?
  saved              Boolean         @default(true)
  attemptCount       Int?            @map("attempt_count")
  catalogCoverage    CatalogCoverage @default(UNAVAILABLE) @map("catalog_coverage")
  currentCourseId    String?         @map("current_course_id")
  durationMs         Int?            @map("duration_ms")
  generatedAt        DateTime?       @map("generated_at")
  inputTokens        Int?            @map("input_tokens")
  missingSkills      Json            @default("[]") @map("missing_skills")
  normalizedGoal     Json?           @map("normalized_goal")
  outputTokens       Int?            @map("output_tokens")
  progressPercent    Int             @default(0) @map("progress_percent")
  retryCount         Int?            @map("retry_count")
  savedAt            DateTime?       @map("saved_at")
  shortExplanation   String?
  status             RoadmapStatus   @default(DRAFT)
  totalTokens        Int?            @map("total_tokens")
  usageSource        UsageSource?    @map("usage_source")
  interpretation     Json?
  confidence         Float           @default(0) @map("goal_confidence")
  assumptions        Json            @default("[]")
  goalCoverage       Int             @default(0) @map("goal_coverage")
  courseAvailability Int             @default(0) @map("course_availability")
  coverageBreakdown  Json            @default("{}") @map("coverage_breakdown")
  roadmapQuality     String          @default("poor") @map("roadmap_quality")
  currentCourse      Course?         @relation(fields: [currentCourseId], references: [id])
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              RoadmapItem[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([tenantId])
}

model RoadmapItem {
  id                  String            @id @default(cuid())
  tenantId            String
  roadmapId           String
  stageNumber         Int
  title               String
  description         String?
  goal                String?
  weekStart           Int
  weekEnd             Int
  courseId            String?
  courseReason        String?
  status              RoadmapItemStatus @default(NOT_STARTED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  completedAt         DateTime?         @map("completed_at")
  estimatedWeeks      Int?              @map("estimated_weeks")
  isTopic             Boolean           @default(false)
  prerequisites       Json              @default("[]")
  reason              String?
  skills              Json              @default("[]")
  startedAt           DateTime?         @map("started_at")
  milestones          Json              @default("[]")
  matchQuality        String?           @map("match_quality")
  matchedCompetencies Json?             @map("matched_competencies")
  course              Course?           @relation(fields: [courseId], references: [id])
  roadmap             Roadmap           @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, stageNumber])
  @@index([courseId])
  @@index([tenantId])
}

model RoadmapGeneration {
  id              String           @id @default(cuid())
  tenantId        String
  userId          String
  fingerprint     String
  status          GenerationStatus @default(QUEUED)
  roadmapId       String?
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  goal            String?
  level           RoadmapLevel?
  durationWeeks   Int?
  hoursPerWeek    Int?
  language        String?
  attemptCount    Int              @default(0)
  lastErrorCode   String?
  lastError       String?
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  qstashMessageId String?
  model           String?
  interpretation  Json?
  progressStage   String?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([status])
  @@index([tenantId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  Comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  actorId   String?
  courseId  String?
  actor     User?            @relation("Notification_actorIdToUser", fields: [actorId], references: [id])
  course    Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User             @relation("Notification_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId, createdAt])
  @@index([userId, read])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  courseId              String
  amountPaid            Int         @default(0)
  currency              String      @default("THB")
  status                OrderStatus @default(PENDING)
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  completedAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  Course                Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([status])
  @@index([userId])
  // At most one in-flight (PENDING) order per user+course. Prevents duplicate
  // Stripe sessions / double charges from concurrent "Buy now" clicks or retries.
  @@unique([userId, courseId, status])
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  SUPERADMIN
}

enum TWO_STEP {
  DISABLED
  EMAIL
  GOOGLE_AUTH
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN
  PASSWORD_RESET
  TWO_FACTOR
}

enum RoadmapLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RoadmapItemStatus {
  SUGGESTED
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum UsageSource {
  provider_reported
  calculated
  unavailable
}

enum ApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CatalogCoverage {
  COMPLETE
  PARTIAL
  WEAK
  UNAVAILABLE
}

enum CertificateRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  READING
}

enum NotificationType {
  COURSE_APPROVED
  COURSE_REJECTED
  COURSE_ENROLLED
  CERTIFICATE_ISSUED
  ROADMAP_READY
  REPORT_RESOLVED
  SYSTEM
  COURSE_SUBMITTED
  CERTIFICATE_REQUESTED
  CERTIFICATE_REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  DISPUTED
  EXPIRED
}

enum RoadmapStatus {
  DRAFT
  SAVED
  ACTIVE
  COMPLETED
}

// ---------------------------------------------------------------------------
// Tenant / multi-tenancy (A1-approved architecture)
// ---------------------------------------------------------------------------

enum TenantRole {
  STUDENT
  INSTRUCTOR
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships TenantMembership[]
}

// Platform identity is User.role. Tenant authority lives here only.
// SUPERADMIN is platform-only and gets NO automatic membership.
model TenantMembership {
  id       String     @id @default(cuid())
  userId   String
  tenantId String
  role     TenantRole @default(STUDENT)
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}
