# ============================================================================
# E-Learning Platform — environment template
# Copy to `.env` and fill in real values. Documented in README (Auth section).
# ============================================================================

# --- Database (Neon PostgreSQL) -------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=verify-full"

# --- Application -----------------------------------------------------------
# Public origin, used to build absolute links in emails (verification, reset, OTP).
APP_URL="http://localhost:3000"
# Runtime for API routes that generate PDFs / probe video durations.
# Do not change unless you know what you are doing.
NODE_ENV="development"

# When behind a trusted reverse proxy (Vercel, nginx, Traefik...), set to "true"
# so client IPs are resolved from proxy headers for rate limiting / audit logs.
# Client IPs are NEVER used for authorization. Default "false" (headers ignored).
# TRUST_PROXY="true"
# Expose coarse in-process metrics at GET /api/metrics.
# METRICS_ENABLED="true"

# --- Auth ------------------------------------------------------------------
# HS256 secrets for the dual-token scheme:
#   access_token  -> short-lived JWT (15 min), signed with JWT_ACCESS_SECRET
#   refresh_token -> opaque token, hashed in DB (RefreshToken table)
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
# Access token lifetime (seconds). Default 900 (15 min).
# JWT_ACCESS_TTL="900"

# Encryption key (32 random bytes, hex-encoded) for secrets at rest — used to
# encrypt TOTP (Google Authenticator) 2FA secrets before they are stored in the
# User table. REQUIRED to enable GOOGLE_AUTH two-step; without it, enabling 2FA
# fails closed (500) rather than persisting a plaintext secret. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=""

# Admin creation invite token.
# REQUIRED when a superadmin creates an instructor account via /api/staff/register.
# Compared once at creation (constant-time), never stored.
ADMIN_INVITE_TOKEN="change-me-admin-invite-token"

# Superadmin bootstrap (prisma/seed.ts only). Not read by the app at runtime.
SUPERADMIN_TOKEN="change-me-superadmin-token"
SUPERADMIN_USERNAME="root"
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="change-me-superadmin-password"

# --- Media (Cloudinary) ----------------------------------------------------
# Videos, PDFs and images are stored in Cloudinary; PostgreSQL stores only
# metadata/references (Asset rows). Lesson media uploads go DIRECT from the
# browser using server-signed parameters (/api/staff/uploads/sign) — files
# never pass through the Next.js server. Media is uploaded as
# `type=authenticated` (private); students receive short-lived signed URLs.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional folder prefix for assets (e.g. "elearning").
CLOUDINARY_FOLDER_PREFIX="elearning"
# Upload policy limits (bytes). Defaults: 2 GiB video, 50 MiB PDF.
UPLOAD_VIDEO_MAX_BYTES=""
UPLOAD_PDF_MAX_BYTES=""
# NOTE: cleanup of abandoned uploads runs WITHOUT any scheduler — it is
# triggered opportunistically by upload traffic (once/day, coordinated via
# Upstash Redis). If QStash is enabled (see below), the self-rescheduling
# worker at /api/media/jobs/worker takes over as the primary trigger; run
# `npx tsx scripts/schedule-media-cleanup.ts` once after first deploy.

# --- Email (SMTP preferred, falls back to Resend, then dev log) -------------
# If SMTP_HOST is set, SMTP is used. Otherwise Resend. With neither, emails are
# only logged to the console.
# Example Gmail (with an app password, NOT your normal Gmail password):
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="465"
#   SMTP_SECURE="true"
#   SMTP_USER="you@gmail.com"
#   SMTP_PASS="your-app-password"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# Optional from address for SMTP (defaults to the SMTP user).
# SMTP_FROM='"E-Learning" <you@gmail.com>'

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="E-Learning <noreply@example.com>"

# --- Rate limiting (Upstash Redis) ----------------------------------------
# Used on auth endpoints (login/register/refresh/otp/reset) and AI roadmap
# generation. Set RATE_LIMIT_ENABLED=false (default) to use the in-memory dev
# fallback. NOTE: in production the roadmap limiter FAILS CLOSED — if these
# values are missing, AI roadmap requests return 503 instead of running
# unthrottled.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_ENABLED="false"

# --- AI roadmap generation (NVIDIA NIM, OpenAI-compatible) -------------------
# Server-only key for the NVIDIA NIM API (free tier). Sent via the
# Authorization: Bearer header, never to the browser.
AI_API_KEY=""
# Full chat completions endpoint (OpenAI-compatible). Defaults to the NVIDIA
# hosted NIM endpoint.
# AI_BASE_URL="https://integrate.api.nvidia.com/v1/chat/completions"
# Optional model override (defaults to the top-ranked model).
# NIM_MODEL=""

# Cost / abuse controls for AI roadmap generation (Upstash-backed in prod).
# Per-user sliding-window requests per minute. Default 10. There is no daily cap.
# ROADMAP_RATE_LIMIT_PER_MIN="10"
# Global cap on concurrent AI calls across all workers. Default 10.
# ROADMAP_MAX_INFLIGHT="10"

# --- Async AI roadmap generation (Upstash QStash) ---------------------------
# Set QSTASH_ENABLED=true in production to process roadmaps asynchronously
# (POST returns 202 + jobId; the signed worker endpoint /api/ai/roadmap/jobs/
# worker runs generation). When false, generation runs inline (dev only).
QSTASH_ENABLED="false"
# Token used to publish messages and the signing keys used to verify the
# Upstash-Signature header on the worker endpoint (from the QStash dashboard).
# QSTASH_TOKEN=""
# QSTASH_CURRENT_SIGNING_KEY=""
# QSTASH_NEXT_SIGNING_KEY=""

# --- Payments (Stripe Checkout) ---------------------------------------------
# Required only for PAID courses. Get test keys (free, no real charges) from
# https://dashboard.stripe.com/test/apikeys — use sk_test_ keys for dev.
# STRIPE_SECRET_KEY="sk_test_..."
# Publishable key is not needed for hosted Checkout, only for Payment Element.
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# The webhook is the authoritative source of truth for payment completion;
# without it the ?payment=success return page still confirms the order.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Open tenant auto-joined by self-registrations (seeded as "default")
DEFAULT_TENANT_SLUG=default
