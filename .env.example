# ============================================================================
# E-Learning Platform — environment template
# Copy to `.env` and fill in real values. Documented in README (Auth section).
# ============================================================================

# --- Database (Neon PostgreSQL) -------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# --- Application -----------------------------------------------------------
# Public origin, used to build absolute links in emails (verification, reset, OTP).
APP_URL="http://localhost:3000"
# Runtime for API routes that generate PDFs / probe video durations.
# Do not change unless you know what you are doing.
NODE_ENV="development"

# --- Auth ------------------------------------------------------------------
# HS256 secrets for the dual-token scheme:
#   access_token  -> short-lived JWT (15 min), signed with JWT_ACCESS_SECRET
#   refresh_token -> opaque token, hashed in DB (RefreshToken table)
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
# Access token lifetime (seconds). Default 900 (15 min).
# JWT_ACCESS_TTL="900"

# Admin creation invite token.
# REQUIRED when a superadmin creates an ADMIN account via /api/admin/register.
# Compared once at creation (constant-time), never stored.
ADMIN_INVITE_TOKEN="change-me-admin-invite-token"

# Superadmin bootstrap (prisma/seed.ts only). Not read by the app at runtime.
SUPERADMIN_TOKEN="change-me-superadmin-token"
SUPERADMIN_USERNAME="root"
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="change-me-superadmin-password"

# --- Media (Cloudinary) ----------------------------------------------------
# Videos, images, profile pictures, and certificate PDFs are stored in
# Cloudinary. Uploads are signed server-side (see /api/uploads).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional folder prefix for assets (e.g. "elearning").
CLOUDINARY_FOLDER_PREFIX="elearning"

# --- Email (SMTP preferred, falls back to Resend, then dev log) -------------
# If SMTP_HOST is set, SMTP is used. Otherwise Resend. With neither, emails are
# only logged to the console.
# Example Gmail (with an app password, NOT your normal Gmail password):
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="465"
#   SMTP_SECURE="true"
#   SMTP_USER="you@gmail.com"
#   SMTP_PASS="your-app-password"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# Optional from address for SMTP (defaults to the SMTP user).
# SMTP_FROM='"E-Learning" <you@gmail.com>'

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="E-Learning <noreply@example.com>"

# --- Rate limiting (Upstash Redis) ----------------------------------------
# Used on auth endpoints (login/register/refresh/otp/reset) and AI roadmap
# generation. Set RATE_LIMIT_ENABLED=false (default) to use the in-memory dev
# fallback. NOTE: in production the roadmap limiter FAILS CLOSED — if these
# values are missing, AI roadmap requests return 503 instead of running
# unthrottled.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_ENABLED="false"

# --- AI roadmap generation (Gemini) ----------------------------------------
# Server-only key. Sent to Google via the x-goog-api-key header, never in URLs
# or to the browser.
GEMINI_API_KEY=""
# Optional model override (defaults to gemini-2.0-flash).
# GEMINI_MODEL="gemini-2.0-flash"
# Optional custom endpoint (e.g. a proxy). Defaults to the Google v1beta URL.
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# Cost / abuse controls for AI roadmap generation (Upstash-backed in prod).
# Per-user sliding-window requests per minute. Default 10.
# ROADMAP_RATE_LIMIT_PER_MIN="10"
# Per-user daily generation attempts (counts attempts, not only successes).
# Default 5. Protects the free-tier Gemini budget.
# ROADMAP_DAILY_LIMIT="5"
# Global cap on concurrent AI calls across all workers. Default 10.
# ROADMAP_MAX_INFLIGHT="10"

# --- Async AI roadmap generation (Upstash QStash) ---------------------------
# Set QSTASH_ENABLED=true in production to process roadmaps asynchronously
# (POST returns 202 + jobId; the signed worker endpoint /api/ai/roadmap/jobs/
# worker runs generation). When false, generation runs inline (dev only).
QSTASH_ENABLED="false"
# Token used to publish messages and the signing keys used to verify the
# Upstash-Signature header on the worker endpoint (from the QStash dashboard).
# QSTASH_TOKEN=""
# QSTASH_CURRENT_SIGNING_KEY=""
# QSTASH_NEXT_SIGNING_KEY=""
